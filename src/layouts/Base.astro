---
// Shared page shell: <head>, Google Tag Manager, header, footer, site-wide scripts.
// Every page wraps its sections in <Base title="..." description="...">.
// The markup structure (page-wrapper > nav_fixed + main.main-wrapper, footer inside main)
// and the stylesheet (webflow.css) are carried over from the Webflow site so the design matches exactly.
import '../styles/webflow.css';
import '../styles/site.css';
import site from '../content/site.json';
import Header from '../sections/Header.astro';
import Footer from '../sections/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Structured data (JSON-LD) objects for this page. */
  schema?: object[];
}
const { title = site.seo_title, description = site.seo_description, image, schema = [] } = Astro.props;
// Pages are built as files (x.html) but published as /x, so the canonical address has no .html and no trailing slash.
const cleanPath = Astro.url.pathname.replace(/(^|\/)index\.html$/, '$1').replace(/\.html$/, '');
const canonical = new URL(cleanPath || '/', Astro.site);
const gtm = site.gtm_id;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
  {image && <meta name="twitter:image" content={new URL(image, Astro.site)} />}
  <link rel="icon" type="image/png" href="/media/wf/67e2ba4f-favicon.png" />
  <link rel="apple-touch-icon" href="/media/wf/67e2ba67-webclip.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300;400;500;600;700&family=Roboto:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
  {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  {gtm && (
    <script is:inline define:vars={{ gtm }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
    </script>
  )}
</head>
<body>
  {gtm && <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtm}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>}
  <div class="page-wrapper">
    <Header />
    <main class="main-wrapper">
      <slot />
      <Footer />
    </main>
  </div>
</body>
</html>
