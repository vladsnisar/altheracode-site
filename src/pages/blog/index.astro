---
// Blog list (/blog), matching the live page: hero, category tabs with all posts, contact form.
// Heading text lives in src/content/pages.json ("blog"); posts are src/content/blog/*.md (newest first).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogHero from '../../sections/BlogHero.astro';
import BlogList from '../../sections/BlogList.astro';
import Contact from '../../sections/Contact.astro';
import pages from '../../content/pages.json';
import home from '../../content/home.json';
const page = pages.blog;
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={page.seo_title} description={page.seo_description}>
  <BlogHero title={page.title} accent={page.title_accent} text={page.lead} />
  <BlogList posts={posts} current="all" />
  <Contact title={home.contact_title} text={home.contact_text} image={home.contact_image} variant="cta-section" />
</Base>
