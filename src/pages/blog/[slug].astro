---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contact from '../../sections/Contact.astro';
import { slugify } from '../../lib/text';
export async function getStaticPaths() {
  const posts = await getCollection('blog', p => !p.data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<Base title={d.seo_title || `${d.title} — AltheraCode`} description={d.seo_description || d.description} image={d.cover}>
  <section class="section"><article class="container prose">
    {d.category && <a class="eyebrow" href={`/blog-category/${slugify(d.category)}`}>{d.category}</a>}
    <h1>{d.title}</h1>
    <p class="post-meta">{d.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</p>
    {d.cover && <img src={d.cover} alt="" />}
    <Content />
    <p style="margin-top:40px"><a href="/blog">← All posts</a></p>
  </article></section>
  <Contact />
</Base>
