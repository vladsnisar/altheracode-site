---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  const posts = await getCollection('blog', p => !p.data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — AltheraCode`} description={post.data.description} image={post.data.cover}>
  <section class="section"><article class="container prose">
    <h1>{post.data.title}</h1>
    <p class="post-meta">{post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
    {post.data.cover && <img src={post.data.cover} alt="" />}
    <Content />
  </article></section>
</Base>
