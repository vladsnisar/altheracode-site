---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ServiceBlock from '../../sections/ServiceBlock.astro';

export async function getStaticPaths() {
  const pages = await getCollection('services', p => !p.data.draft);
  return pages.map(p => ({ params: { slug: p.id }, props: { page: p } }));
}
const { page } = Astro.props;
---
<Base title={page.data.title} description={page.data.description}>
  {page.data.sections.map(block => <ServiceBlock block={block} />)}
</Base>
