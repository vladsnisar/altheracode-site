---
// One blog category (/blog-category/<slug>): same as /blog, showing only that category's posts with its tab highlighted.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogHero from '../../sections/BlogHero.astro';
import BlogList from '../../sections/BlogList.astro';
import Contact from '../../sections/Contact.astro';
import { slugify } from '../../lib/text';
import cats from '../../content/blog-categories.json';
import pages from '../../content/pages.json';
import home from '../../content/home.json';
export function getStaticPaths() {
  return cats.blog_categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const page = pages.blog;
const posts = (await getCollection('blog', (p) => !p.data.draft && slugify(p.data.category ?? '') === cat.slug))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`${cat.name} — AltheraCode Blog`} description={`AltheraCode blog posts about ${cat.name}.`}>
  <BlogHero title={page.title} accent={page.title_accent} text={page.lead} />
  <BlogList posts={posts} current={cat.slug} />
  <Contact title={home.contact_title} text={home.contact_text} image={home.contact_image} variant="cta-section" />
</Base>
