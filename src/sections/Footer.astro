---
// Site footer: logo, service links, locations, contacts, social links and legal links.
// Markup and class names match the Webflow site; text and links come from site.json.
// In location names and addresses, a line break in the CMS starts a new line.
import site from '../content/site.json';
import SocialIcon from './SocialIcon.astro';

const lines = (s: string) => s.split('\n');
const tel = (n: string) => 'tel:' + n.replace(/\s/g, '');
---
<section class="footer">
  <div class="padding-global padding-section-medium">
    <div class="container-large">
      <div class="footer-wrap">
        <div class="w-layout-vflex flex-block">
          <a href="/" class="footer-logo w-inline-block">
            <img src={site.logo} loading="lazy" alt="Althera Code logo" />
          </a>
          <div class="w-layout-vflex footer-links-services">
            {site.footer_service_links.map((l) => <a href={l.href} class="footer-link">{l.label}</a>)}
          </div>
        </div>
        <div class="footer-collumn-wrap">
          <div class="footer-collumn">
            <div class="heading-style-h5">Locations</div>
            {site.locations.map((loc) => (
              <div class="footer-item">
                <div class="country-title">
                  {loc.flag && <img src={loc.flag} loading="lazy" width="31" alt="" />}
                  <div>{lines(loc.name).map((l, i) => <>{i > 0 && <br />}{l}</>)}</div>
                </div>
                <div>{lines(loc.address).map((l, i) => <>{i > 0 && <br />}{l}</>)}</div>
              </div>
            ))}
          </div>
          <div class="footer-collumn contact-collumn">
            <div class="heading-style-h5">Contacts</div>
            <div class="footer-item">
              <div class="heading-style-h5">Phone</div>
              <a href={tel(site.contact_phone)} class="footer-link w-inline-block"><div>{site.contact_phone}</div></a>
            </div>
            <div class="footer-item">
              <div class="heading-style-h5">WhatsApp</div>
              <a href={site.contact_whatsapp_link} class="footer-link w-inline-block"><div>{site.contact_whatsapp}</div></a>
            </div>
            <div class="footer-item">
              <div>E-mail</div>
              <div><a href={`mailto:${site.contact_email}`} class="footer-link">{site.contact_email}</a></div>
            </div>
          </div>
        </div>
      </div>
      <div class="footer-space-64"></div>
      <div class="footer-social-wrap">
        <div class="w-layout-grid footer-social-grid">
          {site.socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label} class="social_link w-inline-block">
              <div class="icon-1x1-medium w-embed"><SocialIcon name={s.label} /></div>
            </a>
          ))}
        </div>
      </div>
      <div class="footer-space-64"></div>
      <div class="footer-legal-wrap">
        <div>{site.copyright}</div>
        <div class="legal-links-wrap">
          {site.legal_links.map((l) => <div><a href={l.href} class="footer-link">{l.label}</a></div>)}
        </div>
      </div>
    </div>
  </div>
</section>
