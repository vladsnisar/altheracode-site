---
// "Our Tech Stack": centered heading and a row of technology logo tiles.
// Used on the homepage, service pages and the portfolio page; logos are passed in from the content files.
import { spacing as pad } from '../lib/spacing';
interface Props {
  title: string;
  /** `width` defaults to 98; `small` adds the live site's `image-3` class used for a few logos. */
  logos: { name: string; image: string; width?: string; small?: boolean }[];
  /** large | bottom | large-no-bottom | none (see src/lib/spacing.ts) */
  spacing?: string;
  /** Extra class on the logo row from the live page ("ai" = tighter gaps, used on service pages). */
  variant?: string;
  /** Hide the slash image before the title (two live pages write the slash into the title instead). */
  no_icon?: boolean;
  /** Extra classes from the live page for the heading box and the title (exact layout). */
  heading_class?: string;
  title_class?: string;
}
const { title, logos, spacing, variant, no_icon = false, heading_class, title_class } = Astro.props;
const alt = 'ALT Althera Code – Innovative Custom Software Development Company. + SVG Image';
---
<section class="section">
  <div class={pad(spacing, 'large')}>
    <div class="container-large">
      <div class="heading-center">
        <div class:list={['heading-box', heading_class]}>
          {!no_icon && <img alt={alt} loading="lazy" src="/media/wf/67d66bce-slash.svg" />}
          <h2 class:list={['heading-style-h2', title_class]}>{title}</h2>
        </div>
      </div>
      <div class="section-space-64"></div>
      <div class:list={['tech-stack-wrap', variant]}>
        {logos.map((l) => (
          <div class="logo-item">
            <img alt={l.name} class:list={[{ 'image-3': l.small }]} loading="lazy" src={l.image} width={l.width || '98'} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
