---
// "Our Tech Stack": centered heading and a row of technology logo tiles.
// Used on the homepage, service pages and the portfolio page; logos are passed in from the content files.
interface Props {
  title: string;
  logos: { name: string; image: string }[];
}
const { title, logos } = Astro.props;
const alt = 'ALT Althera Code – Innovative Custom Software Development Company. + SVG Image';
---
<section class="section">
  <div class="padding-global padding-section-large">
    <div class="container-large">
      <div class="heading-center">
        <div class="heading-box">
          <img alt={alt} loading="lazy" src="/media/wf/67d66bce-slash.svg" />
          <h2 class="heading-style-h2">{title}</h2>
        </div>
      </div>
      <div class="section-space-64"></div>
      <div class="tech-stack-wrap">
        {logos.map((l) => (
          <div class="logo-item">
            <img alt={l.name} loading="lazy" src={l.image} width="98" />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
