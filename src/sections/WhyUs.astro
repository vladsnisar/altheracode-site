---
// "Why Choose AltheraCode": heading, tag and a grid of cards with icons.
// Used on the homepage and service pages; text and icons are passed in from the content files.
interface Props {
  title: string;
  eyebrow?: string;
  items: { icon?: string; title: string; text: string }[];
}
const { title, eyebrow, items } = Astro.props;
const alt = 'ALT Althera Code – Innovative Custom Software Development Company. + SVG Image';
---
<section class="section">
  <div class="padding-global padding-section-botton">
    <div class="container-large">
      <div class="why-heading-wrap">
        <div class="heading-text-wrap max-width-800">
          <div class="heading-box">
            <img alt={alt} loading="lazy" src="/media/wf/67d66bce-slash.svg" />
            <h2 class="heading-style-h2">{title}</h2>
          </div>
        </div>
        {eyebrow && (
          <div class="section-tag-box light-purple first">
            <div class="tag-bullet"></div>
            <div>{eyebrow}</div>
          </div>
        )}
      </div>
      <div class="section-space-64"></div>
      <div class="w-layout-grid why-grid">
        {items.map((it) => (
          <div class="why-card">
            {it.icon && <img alt="" loading="lazy" src={it.icon} />}
            <h3 class="heading-style-h4">{it.title}</h3>
            <div>{it.text}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
