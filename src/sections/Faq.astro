---
// "Questions & Answers": tag and heading on the left, numbered questions on the right that open and close on click.
// Used on the homepage and service pages. Questions are numbered automatically; answers use the CMS text format
// (blank line = new paragraph, "- " or "1. " lines = lists, see src/lib/text.ts).
import { richText } from '../lib/text';
import { spacing as pad } from '../lib/spacing';

interface Props {
  title: string;
  eyebrow?: string;
  items: { q: string; a: string }[];
  id?: string;
  /** large | bottom | large-no-bottom | none (see src/lib/spacing.ts) */
  spacing?: string;
  /** Wider left column (the live site's `larger` variant, used on most service pages). */
  wide?: boolean;
}
const { title, eyebrow, items, id = 'faq', spacing, wide = false } = Astro.props;
// A question that already starts with its own number (e.g. "9: …") is shown as written.
const label = (q: string, i: number) => (/^\d+[.:]\s/.test(q) ? q : `${i + 1}. ${q}`);
---
<section class="section" id={id}>
  <div class={pad(spacing, 'none')}>
    <div class="container-large">
      <div class="faq-wrap">
        <div class:list={['faq-title-wrap', { larger: wide }]}>
          {eyebrow && (
            <div class="section-tag-box last">
              <div class="tag-bullet"></div>
              <div>{eyebrow}</div>
            </div>
          )}
          <h2 class="heading-style-h2">{title}</h2>
        </div>
        <div class="faq-list">
          {items.map((it, i) => (
            <div class="dropdown-item">
              <a class="dropdown-item-title w-inline-block" href="#" role="button" aria-expanded="false" aria-controls={`${id}-a${i + 1}`}>
                <h3 class="heading-style-h4">{label(it.q, i)}</h3>
              </a>
              <div class="dropdown-item-content" id={`${id}-a${i + 1}`} style="height:0px" set:html={richText(it.a)} />
              <img class="image-2" loading="lazy" src="/media/wf/67d91e2c-fi-sr-plus.svg" alt="" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Each question opens and closes on its own (several can be open), with the plus icon turning into ×,
  // as Webflow's interaction did on the live site.
  document.querySelectorAll<HTMLElement>('.faq-list .dropdown-item').forEach((item) => {
    const title = item.querySelector<HTMLAnchorElement>('.dropdown-item-title');
    const body = item.querySelector<HTMLElement>('.dropdown-item-content');
    const icon = item.querySelector<HTMLElement>('.image-2');
    if (!title || !body) return;
    body.style.transition = 'height 0.4s ease';
    if (icon) icon.style.transition = 'transform 0.4s ease';
    title.addEventListener('click', (e) => {
      e.preventDefault();
      const open = title.getAttribute('aria-expanded') !== 'true';
      title.setAttribute('aria-expanded', String(open));
      if (icon) icon.style.transform = open ? 'rotate(45deg)' : '';
      if (open) {
        body.style.height = body.scrollHeight + 'px';
        body.addEventListener('transitionend', () => { if (title.getAttribute('aria-expanded') === 'true') body.style.height = 'auto'; }, { once: true });
      } else {
        body.style.height = body.scrollHeight + 'px';
        requestAnimationFrame(() => requestAnimationFrame(() => (body.style.height = '0px')));
      }
    });
  });
</script>
