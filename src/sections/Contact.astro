---
// "Drop Us a Line" section: heading, the contact form (ContactForm.astro) and a photo. Markup matches the Webflow site.
// `variant` sets the section's spacing classes, which differ between pages on the live site.
import home from '../content/home.json';
import ContactForm from './ContactForm.astro';

interface Props {
  title?: string;
  text?: string;
  image?: string;
  variant?: string;
  /** h2 (default) | h3: smaller heading, used on one live page */
  size?: string;
  /** Classes of the inner padding box (case study pages use large section padding). */
  pad?: string;
}
const {
  title = home.contact_title,
  text = home.contact_text,
  image = '/media/wf/67d92299-business-people-working-office-with-laptop-1.avif',
  variant = 'cta-section top',
  size = 'h2',
  pad = 'padding-global phone-non',
} = Astro.props;
const alt = 'ALT Althera Code – Innovative Custom Software Development Company. + SVG Image';
---
<section class:list={['section', variant]} id="contact">
  <div class={pad}>
    <div class="container-large">
      <div class="form-block">
        <div class="form-box">
          <div class="form-title">
            <div class="heading-box">
              <img alt={alt} loading="lazy" src="/media/wf/67d66bce-slash.svg" />
              <h2 class={size === 'h3' ? 'heading-style-h3' : 'heading-style-h2'}>{title}</h2>
            </div>
            {text && <div class="form-text">{text}</div>}
          </div>
          <ContactForm />
        </div>
        <img alt="Two colleagues working together at a laptop" class="form-image" loading="lazy" src={image} width="585" />
      </div>
    </div>
  </div>
</section>
