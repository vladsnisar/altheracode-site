---
// "Our Portfolio" block: heading, intro, tag and a grid of case-study cards.
// Used on the homepage (six newest case studies) and on service pages (the cases chosen for that page).
// Card text comes from the case-study files in src/content/portfolio/.
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  text?: string;
  eyebrow?: string;
  cases: CollectionEntry<'portfolio'>[];
}
const { title, text, eyebrow, cases } = Astro.props;
const alt = 'ALT Althera Code – Innovative Custom Software Development Company. + SVG Image';
---
<section class="section">
  <div class="padding-global padding-section-large">
    <div class="container-large">
      <div class="portfolio-heading-wrap">
        <div class="heading-text-wrap max-width-800">
          <div class="heading-box">
            <img alt={alt} loading="lazy" src="/media/wf/67d4099c-image.svg" />
            <h2 class="heading-style-h2">{title}</h2>
          </div>
          {text && <p class="portfolio-text">{text}</p>}
        </div>
        {eyebrow && (
          <div class="section-tag-box first">
            <div class="tag-bullet"></div>
            <div>{eyebrow}</div>
          </div>
        )}
      </div>
      <div class="section-space-96"></div>
      <div class="portfolio-collection w-dyn-list">
        <div class="portfolio-grid w-dyn-items" role="list">
          {cases.map((c) => (
            <div class="portfolio-card w-dyn-item" role="listitem">
              <div class="portfolio-tags-wrap">
                <div class:list={['portfolio-tag', { 'w-condition-invisible': !(c.data.nda && c.data.tag) }]}>{c.data.tag}</div>
                <div class="cms-spacer"></div>
                <div class="category-list w-dyn-list">
                  <div class="collection-list-2 w-dyn-items" role="list">
                    {c.data.categories.map((cat) => (
                      <div class="w-dyn-item" role="listitem">
                        <div class="portfolio-tag light-blue">{cat}</div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
              <div class="heading-text-wrap margin-bottom-32">
                <h3 class="heading-style-h4">{c.data.title}</h3>
                <div>{c.data.description}</div>
              </div>
              <a class="portfolio-link w-inline-block" href={`/portfolio/${c.id}`}>
                <div>Learn More</div>
              </a>
            </div>
          ))}
        </div>
        <div role="navigation" aria-label="List" class="w-pagination-wrapper pagination"></div>
      </div>
    </div>
  </div>
</section>
