---
// Renders ONE section of a service page or custom page. The sections come from src/content/services/<page>.json
// or src/content/custom-pages/<page>.json (edited in Pages CMS). The `type` field picks the design; every design
// matches a section of the live Webflow site.
import { getCollection } from 'astro:content';
import ServiceHero from './ServiceHero.astro';
import ServiceIntro from './ServiceIntro.astro';
import Cards from './Cards.astro';
import CardSlider from './CardSlider.astro';
import ServiceCta from './ServiceCta.astro';
import Portfolio from './Portfolio.astro';
import IndustriesGrid from './IndustriesGrid.astro';
import Testimonials from './Testimonials.astro';
import Process from './Process.astro';
import TechStack from './TechStack.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';

const { block: b } = Astro.props;
// Lists can be missing while a section is still being filled in the CMS; treat them as empty so the build doesn't fail.
const list = (x: unknown) => (Array.isArray(x) ? x : []);
const cases = b.type === 'cases'
  ? (await getCollection('portfolio', (p) => !p.data.draft))
      .filter((c) => list(b.cases).includes(c.id))
      .sort((x, y) => list(b.cases).indexOf(x.id) - list(b.cases).indexOf(y.id))
  : [];
---
{b.type === 'hero' && (
  <ServiceHero breadcrumb={b.breadcrumb} title={b.title ?? ''} title_accent={b.title_accent} accent_color={b.accent_color}
    text={b.text} button_text={b.button_text} button_link={b.button_link || '/contact'} background={b.background} braces={b.braces} heading_class={b.heading_class} title_class={b.title_class} />
)}
{b.type === 'intro' && <ServiceIntro style={b.style} tag={b.tag} title={b.title ?? ''} text={b.text} image={b.image} list={list(b.list)} icon_class={b.icon_class} heading_class={b.heading_class} title_class={b.title_class} />}
{b.type === 'cards' && (
  <Cards dark={!!b.dark} title={b.title ?? ''} accent={b.accent} accent_color={b.accent_color} tag={b.tag} text={b.text}
    header={b.header} grid={b.grid} tail_row={Number(b.tail_row) || 0} tail_wrap={b.tail_wrap} card_class={b.card_class} inner={b.inner}
    items={list(b.items)} spacing={b.spacing} />
)}
{b.type === 'slider' && <CardSlider dark={!!b.dark} title={b.title ?? ''} text={b.text} items={list(b.items)} spacing={b.spacing} heading_class={b.heading_class} title_class={b.title_class} />}
{b.type === 'cta' && (
  <ServiceCta title={b.title ?? ''} accent={b.accent} accent_color={b.accent_color} button_text={b.button_text}
    button_link={b.button_link || '/contact'} button_style={b.button_style} braces={b.braces} size={b.size} brace_height={b.brace_height} spacing={b.spacing} />
)}
{b.type === 'cases' && cases.length > 0 && (
  <Portfolio title={b.title ?? ''} text={b.text} eyebrow={b.tag} cases={cases} spacing={b.spacing} narrow={b.narrow !== false} heading_class={b.heading_class} title_class={b.title_class} />
)}
{b.type === 'industries' && (
  <IndustriesGrid title={b.title ?? ''} accent={b.accent} tag={b.tag} header={b.header} items={list(b.items)} spacing={b.spacing} />
)}
{b.type === 'testimonials' && <Testimonials title={b.title ?? ''} spacing={b.spacing} />}
{b.type === 'process' && <Process title={b.title ?? ''} eyebrow={b.tag} text={b.text} steps={list(b.steps)} />}
{b.type === 'tech' && <TechStack title={b.title ?? ''} logos={list(b.logos)} spacing={b.spacing} variant={b.variant} no_icon={!!b.no_icon} heading_class={b.heading_class} title_class={b.title_class} />}
{b.type === 'faq' && <Faq title={b.title ?? ''} eyebrow={b.tag} items={list(b.items)} spacing={b.spacing} wide={!!b.wide} />}
{b.type === 'contact' && (
  <Contact title={b.title} text={b.text} size={b.size} variant={b.variant === 'plain' ? 'cta-section' : 'cta-section top'} />
)}
{b.type === 'spacer' && <section class="section"><div class="padding-global phone-non"></div></section>}
